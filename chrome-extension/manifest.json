{
  "manifest_version": 3,
  "name": "Spectra QA - Network & API Sniffer",
  "version": "1.0.0",
  "description": "Real-time Network Traffic Sniffer & API Extractor for Spectra QA Automation Platform",
  "icons": {
    "16": "icon16.png",
    "48": "icon48.png",
    "128": "icon128.png"
  },
  "permissions": [
    "webRequest",
    "activeTab",
    "storage",
    "scripting",
    "tabs"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "Spectra QA Sniffer",
    "default_icon": {
      "16": "icon16.png",
      "48": "icon48.png",
      "128": "icon128.png"
    }
  },
  "background": {
    "service_worker": "background.js"
  }
}
