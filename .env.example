# Thai OCR & Spectra QA Consult - Environment Configuration
# Copy this file to .env and adjust the values for your environment

# ─────────────────────────────────────────────
# Database Configuration (PostgreSQL 16 + pgvector)
# ─────────────────────────────────────────────
DB_HOST=127.0.0.1
DB_PORT=8123
DB_NAME=qa_agent_db
OCR_DB_NAME=qa_agent_db
DB_USER=qa_admin
DB_PASS=qa_password

# ─────────────────────────────────────────────
# Authentication Database Configuration (PostgreSQL 16)
# ─────────────────────────────────────────────
AUTH_DB_HOST=127.0.0.1
AUTH_DB_PORT=8124
AUTH_DB_NAME=postgres
AUTH_DB_USER=postgres
AUTH_DB_PASS=postgres

# ─────────────────────────────────────────────
# Google AI Studio (Gemini) API
# Get your API key at: https://aistudio.google.com/app/apikey
# ─────────────────────────────────────────────
GOOGLE_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash

# ─────────────────────────────────────────────
# Email Notification Settings (Gmail SMTP)
# ─────────────────────────────────────────────
GMAIL_USER=your_email@gmail.com
GMAIL_APP_PASSWORD=your_gmail_app_password_here

# ─────────────────────────────────────────────
# Flask Server & Environment Settings
# ─────────────────────────────────────────────
FLASK_ENV=production
FLASK_DEBUG=0
SECRET_KEY=generate_a_strong_secret_key_here

# ─────────────────────────────────────────────
# Exposed Host Ports (Docker Compose)
# ─────────────────────────────────────────────
FRONTEND_PORT=5173
BACKEND_PORT=8125
# Base URL for Email Links (Optional - defaults to request Host e.g. http://203.151.56.27:5173)
PUBLIC_BASE_URL=http://203.151.56.27:5173

# ─────────────────────────────────────────────
# System Paths (Windows local only; Docker sets POPPLER_PATH automatically)
# ─────────────────────────────────────────────
# POPPLER_PATH=C:\poppler\Library\bin\pdftoppm.exe

